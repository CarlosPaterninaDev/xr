{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Unicorsalud design tokens extraídos de https://unicorsalud.edu.co/ (nov 2026)",
  "color": {
    "brand": {
      "red":        { "$type": "color", "$value": "#D71920", "$description": "Rojo institucional web (títulos, divisores, fondos)" },
      "red-bright": { "$type": "color", "$value": "#E52832", "$description": "Hover / acentos" },
      "red-logo":   { "$type": "color", "$value": "#E41838", "$description": "Rojo del logo UC" },
      "red-deep":   { "$type": "color", "$value": "#92161D", "$description": "Final de degradado" },
      "red-ink":    { "$type": "color", "$value": "#6B0F14", "$description": "Derivado: rojo muy oscuro" },
      "red-tint":   { "$type": "color", "$value": "#FBE8E9", "$description": "Derivado: rojo suave" }
    },
    "accent": {
      "yellow":      { "$type": "color", "$value": "#FBAF17", "$description": "CTA secundario" },
      "orange-glow": { "$type": "color", "$value": "#CC4300" }
    },
    "neutral": {
      "ink":        { "$type": "color", "$value": "#1D1D1B" },
      "ink-strong": { "$type": "color", "$value": "#1A1A1A" },
      "black":      { "$type": "color", "$value": "#101010" },
      "graphite":   { "$type": "color", "$value": "#3C3C3B" },
      "gray":       { "$type": "color", "$value": "#707070" },
      "line":       { "$type": "color", "$value": "#E4E4E4" },
      "cream":      { "$type": "color", "$value": "#FDFDF2" },
      "white":      { "$type": "color", "$value": "#FFFFFF" }
    }
  },
  "gradient": {
    "red":      { "$type": "gradient", "$value": "linear-gradient(0deg, #E52832 0%, #92161D 100%)" },
    "red-diag": { "$type": "gradient", "$value": "linear-gradient(135deg, #E52832 0%, #D71920 45%, #92161D 100%)" }
  },
  "font": {
    "family": {
      "sans":   { "$type": "fontFamily", "$value": ["Gotham", "Montserrat", "Helvetica Neue", "Arial", "sans-serif"] },
      "script": { "$type": "fontFamily", "$value": ["Allison", "Great Vibes", "cursive"] }
    },
    "weight": { "light": 300, "book": 400, "medium": 500, "semibold": 600, "bold": 700, "black": 900 },
    "size-web-px": [9, 12, 14, 15, 18, 20, 25, 31, 45, 80],
    "size-slide-px": { "caption": 20, "small": 24, "body": 30, "lead": 38, "h4": 44, "h3": 56, "h2": 76, "h1": 104, "display": 160, "stat": 190 },
    "letter-spacing": { "tight": "-0.02em", "caps": "0.08em" }
  },
  "radius": { "xs": "3px", "sm": "10px", "md": "15px", "lg": "20px", "xl": "30px", "pill": "999px" },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "20px", "5": "32px", "6": "48px", "7": "72px", "8": "112px" },
  "border": { "divider": "5px solid #D71920", "hairline": "1px solid #E4E4E4" },
  "shadow": {
    "sm": "0 5px 15px rgba(0,0,0,.25)",
    "md": "0 8px 20px rgba(0,0,0,.30)",
    "soft": "0 0 10px rgba(0,0,0,.5)",
    "glow": "0 0 10px 0 #CC4300",
    "red": "0 18px 40px -12px rgba(146,22,29,.55)"
  },
  "motion": {
    "duration": { "fast": "300ms", "base": "600ms", "slow": "900ms", "slide": "800ms" },
    "easing": { "out": "cubic-bezier(.22,1,.36,1)", "in-out": "cubic-bezier(.65,0,.35,1)", "pop": "cubic-bezier(.34,1.56,.64,1)" },
    "stagger": "110ms",
    "web-animations": ["fadeInUp", "pop (hover)", "pulse (hover)", "wobble-vertical (hover)", "swiper slides"]
  }
}
